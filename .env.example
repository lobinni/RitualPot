# Copy to .env and adjust. Nothing here is required for reading a live contract:
# the console also reads its address from deployments/registry.json.

# PostgreSQL, used by the runtime deployment record only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Pins the contract address for one build. Wins over the database record and the registry.
# See docs/CONFIGURATION.md for the full resolution order.
NEXT_PUBLIC_RITUALPOT_ADDRESS=

# Which entry of deployments/registry.json this build talks to. Defaults to defaultNetwork.
NEXT_PUBLIC_RITUALPOT_NETWORK=

# Overrides the endpoint and explorer of the selected network.
NEXT_PUBLIC_RITUALPOT_RPC=
NEXT_PUBLIC_RITUALPOT_EXPLORER=
